MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/yarastore?appName=Cluster0
JWT_SECRET=your_super_secret_key_here
PORT=5000
NODE_ENV=development
FRONTEND_URL=https://your-store-domain.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# إشعار تيليجرام عند إنشاء طلب جديد — اختياري، بلا القيمتين ما بينبعت أي إشعار
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id
